{
  "id": "omp-session",
  "apiVersion": 1,
  "version": "0.1.0",
  "displayName": "OMP Sessions",
  "description": "View an agent's recent runs: session runtime, usage, and cost from heartbeat_runs and cost_events.",
  "author": "Oh My Pi (omp-paperclip-adapter)",
  "categories": ["ui"],
  "capabilities": [
    "database.namespace.migrate",
    "database.namespace.read",
    "agents.read"
  ],
  "entrypoints": {
    "worker": "dist/worker.js",
    "ui": "dist/ui"
  },
  "database": {
    "migrationsDir": "migrations",
    "coreReadTables": ["heartbeat_runs", "cost_events"]
  },
  "ui": {
    "slots": [
      {
        "type": "detailTab",
        "id": "omp-session-overview",
        "displayName": "OMP Sessions",
        "entityTypes": ["agent"],
        "exportName": "OmpSessionOverview"
      }
    ]
  }
}
